# Copy to .env and adjust. All values have safe defaults except PASSWORD.
# Server
PORT=20042
HOST=0.0.0.0

# Auth (change this!)
PASSWORD=passw
# SECRET_KEY: session signing key. Auto-generated and persisted to
# .secret_key on first run if left empty.
SECRET_KEY=

# Storage locations
UPLOAD_DIR=airdrop_files
TMP_DIR=airdrop_tmp
PUBLIC_DIR=public_uploads

# Public API limits
MAX_FILE_SIZE_GB=5
MAX_MULTI_FOLDER_TOTAL_GB=1
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_UPLOADS=30

# Bandwidth policy (sliding 60s windows)
# Per-IP soft cap per minute: exceeding it throttles to THROTTLE_MBPS + linear mode
BW_IP_SOFT_MB=100
# Per-IP hard cap per minute / per-folder hard cap per minute
BW_IP_HARD_GB=1
BW_FOLDER_HARD_GB=5
# Distinct folders touched per IP per minute before throttling
BW_FOLDERS_PER_MIN=10
# Throttled speed (megabits per second)
THROTTLE_MBPS=90
