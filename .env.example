# Copy to .env and adjust. All values have safe defaults except PASSWORD.
# Server
PORT=20042
HOST=0.0.0.0

# Auth (change this!)
PASSWORD=passw
# SECRET_KEY: session signing key. Auto-generated and persisted to
# .secret_key on first run if left empty.
SECRET_KEY=

# Storage locations
UPLOAD_DIR=airdrop_files
TMP_DIR=airdrop_tmp
PUBLIC_DIR=public_uploads

# Public API limits (private/logged-in uploads are uncapped)
MAX_FILE_SIZE_GB=5
# Max chunks per chunked upload (x 4MB each; 16384 = ~64GB files)
MAX_CHUNKED_PARTS=16384
# Abandoned chunk dirs older than this (hours) are auto-deleted
TMP_MAX_AGE_HOURS=24
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_UPLOADS=30

# Bandwidth policy (sliding windows, reset every BW_WINDOW_SECONDS)
BW_WINDOW_SECONDS=600
# Per-IP soft cap per window: exceeding it throttles + locks linear mode
BW_IP_SOFT_MB=100
# Per-folder hard cap per window (forces minimum speed)
BW_FOLDER_HARD_GB=5
# Distinct folders touched per IP per window before throttling
BW_FOLDERS_PER_WINDOW=10
# Throttle tiers: MAX past the soft cap, -TIER_MBPS every TIER_GB, floor MIN
# e.g. 100MB->90, 1GB->80, 2GB->70 ... 5GB+->40
THROTTLE_MAX_MBPS=90
THROTTLE_MIN_MBPS=40
BW_TIER_GB=1
BW_TIER_MBPS=10
